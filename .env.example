# ---------- Основное ----------
NODE_ENV=development
PORT=3000

# PostgreSQL. Локально — из docker-compose.yml; на Railway — ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://book:book@localhost:5432/book

# Секрет для подписи сессий админа: длинная случайная строка (минимум 32 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ---------- Администратор ----------
# Создаётся при первом запуске, в БД хранится только bcrypt-хэш пароля.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# true — перезаписать пароль существующего админа из ADMIN_PASSWORD (потом убрать)
ADMIN_RESET_PASSWORD=false

# ---------- Хранилище файлов ----------
# local — диск (локально ./storage/uploads, на Railway — Volume, смонтированный в /data)
# s3    — любое S3-совместимое хранилище (AWS S3, Cloudflare R2, Backblaze B2, MinIO)
STORAGE_TYPE=local
STORAGE_DIR=./storage/uploads

S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Публичный адрес, по которому отдаются файлы бакета (например, https://cdn.example.com)
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# Лимиты загрузки, МБ
MAX_AUDIO_MB=25
MAX_IMAGE_MB=10

# Нужен только если фронтенд работает на другом домене (через запятую)
CORS_ORIGIN=

# true — при старте контейнера создать демо-книгу, если в базе ещё нет глав
SEED_DEMO=false
